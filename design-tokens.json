{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Vedanta Inventory Dashboard — Design Tokens. Direction: Grafana-calm. Source of truth until a Figma file is connected.",

  "color": {
    "light": {
      "surface": {
        "page": "#F8FAFC",
        "primary": "#FFFFFF",
        "elevated": "#FFFFFF"
      },
      "border": {
        "default": "rgba(15, 23, 42, 0.08)",
        "strong": "rgba(15, 23, 42, 0.15)"
      },
      "text": {
        "primary": "#0F172A",
        "secondary": "#475569",
        "muted": "#94A3B8",
        "inverse": "#FFFFFF"
      },
      "accent": {
        "default": "#2563EB",
        "hover": "#1D4ED8",
        "subtle": "#EFF6FF"
      },
      "status": {
        "success": { "foreground": "#16A34A", "background": "#F0FDF4" },
        "warning": { "foreground": "#D97706", "background": "#FFFBEB" },
        "danger": { "foreground": "#DC2626", "background": "#FEF2F2" },
        "info": { "foreground": "#0284C7", "background": "#F0F9FF" },
        "neutral": { "foreground": "#64748B", "background": "#F1F5F9" }
      },
      "chart": {
        "series1": "#2563EB",
        "series2": "#10B981",
        "series3": "#F59E0B",
        "series4": "#F43F5E",
        "series5": "#8B5CF6"
      }
    },
    "dark": {
      "surface": {
        "page": "#0F172A",
        "primary": "#1E293B",
        "elevated": "#334155"
      },
      "border": {
        "default": "rgba(248, 250, 252, 0.08)",
        "strong": "rgba(248, 250, 252, 0.15)"
      },
      "text": {
        "primary": "#F8FAFC",
        "secondary": "#CBD5E1",
        "muted": "#64748B",
        "inverse": "#0F172A"
      },
      "accent": {
        "default": "#3B82F6",
        "hover": "#60A5FA",
        "subtle": "rgba(59, 130, 246, 0.1)"
      },
      "status": {
        "success": { "foreground": "#4ADE80", "background": "rgba(74, 222, 128, 0.1)" },
        "warning": { "foreground": "#FBBF24", "background": "rgba(251, 191, 36, 0.1)" },
        "danger": { "foreground": "#F87171", "background": "rgba(248, 113, 113, 0.1)" },
        "info": { "foreground": "#38BDF8", "background": "rgba(56, 189, 248, 0.1)" },
        "neutral": { "foreground": "#94A3B8", "background": "rgba(148, 163, 184, 0.1)" }
      },
      "chart": {
        "series1": "#3B82F6",
        "series2": "#34D399",
        "series3": "#FBBF24",
        "series4": "#FB7185",
        "series5": "#A78BFA"
      }
    }
  },

  "typography": {
    "fontFamily": {
      "sans": "'Inter', system-ui, -apple-system, sans-serif",
      "mono": "'JetBrains Mono', 'Fira Code', ui-monospace, monospace"
    },
    "scale": {
      "display": { "fontSize": "32px", "fontWeight": 700, "lineHeight": 1.2, "letterSpacing": "-0.02em" },
      "h1": { "fontSize": "24px", "fontWeight": 600, "lineHeight": 1.3, "letterSpacing": "-0.01em" },
      "h2": { "fontSize": "20px", "fontWeight": 600, "lineHeight": 1.3, "letterSpacing": "0" },
      "body": { "fontSize": "14px", "fontWeight": 400, "lineHeight": 1.5, "letterSpacing": "0" },
      "label": { "fontSize": "14px", "fontWeight": 500, "lineHeight": 1.4, "letterSpacing": "0" },
      "caption": { "fontSize": "12px", "fontWeight": 400, "lineHeight": 1.5, "letterSpacing": "0.01em" },
      "metric": { "fontSize": "32px", "fontWeight": 700, "lineHeight": 1.0, "letterSpacing": "-0.02em" },
      "metricLabel": { "fontSize": "12px", "fontWeight": 500, "lineHeight": 1.4, "letterSpacing": "0.05em", "textTransform": "uppercase" }
    }
  },

  "spacing": {
    "$comment": "4px base unit. Token name = multiplier.",
    "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px",
    "6": "24px", "8": "32px", "10": "40px", "12": "48px"
  },

  "radii": { "sm": "6px", "md": "8px", "full": "9999px" },

  "elevation": {
    "sm": "0 1px 2px rgba(0, 0, 0, 0.05)",
    "md": "0 4px 6px -1px rgba(0, 0, 0, 0.07), 0 2px 4px -2px rgba(0, 0, 0, 0.05)",
    "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.08), 0 4px 6px -4px rgba(0, 0, 0, 0.04)"
  },

  "motion": {
    "duration": { "fast": "150ms", "normal": "200ms", "slow": "300ms" },
    "easing": { "default": "ease-out" },
    "reducedMotion": { "$comment": "When prefers-reduced-motion: reduce, set all durations to 0ms." }
  },

  "layout": {
    "maxWidth": "1280px",
    "pagePadding": { "desktop": "24px", "mobile": "16px" },
    "breakpoints": { "phone": "390px", "tablet": "768px", "desktop": "1440px" },
    "grid": { "columns": 12, "gap": "16px" }
  },

  "components": {
    "summaryCard": { "height": "120px", "padding": "24px", "borderRadius": "8px", "borderWidth": "1px" },
    "flagBadge": { "height": "24px", "paddingX": "8px", "paddingY": "4px", "borderRadius": "9999px", "fontSize": "12px", "fontWeight": 500 },
    "dataTable": { "rowHeight": "40px", "cellPaddingX": "12px", "cellPaddingY": "8px", "headerFontWeight": 500, "numericFontVariant": "tabular-nums" },
    "themeToggle": { "size": "36px", "iconSize": "20px", "borderRadius": "8px" },
    "controlHeights": { "sm": "32px", "md": "36px", "lg": "40px" },
    "focusRing": { "width": "2px", "offset": "2px", "color": "var(--accent)" }
  },

  "icons": {
    "library": "lucide",
    "sizes": { "inline": "16px", "button": "20px", "emptyState": "48px" }
  },

  "flagMapping": {
    "$comment": "Maps inventory status flags to semantic colour tokens.",
    "healthy": "status.success",
    "overstock": "status.warning",
    "understock": "status.danger",
    "nmi": "status.info",
    "smi": "status.warning",
    "noFlag": "status.neutral"
  }
}
