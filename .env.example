# =============================================================================
# .env.example — Inventory & Forecasting Cell (VEDANTA POC)
# KritikasinghCL/cirruslabs-qa-e2e-test-cohort
# =============================================================================
# Copy this file to .env and fill in every value before running the project.
# NEVER commit .env — it is listed in .gitignore.
# Every variable listed here is required unless marked [optional].
# =============================================================================


# -----------------------------------------------------------------------------
# SAP HANA — primary data source
# Obtain from: SAP BTP cockpit → your HANA Cloud instance → "SQL Endpoint"
# The host is the full *.hanacloud.ondemand.com hostname (no port suffix).
# -----------------------------------------------------------------------------

# Fully-qualified HANA Cloud hostname, e.g. abc123.hna0.prod-us10.hanacloud.ondemand.com
HANA_HOST=your-instance-id.hna0.prod-us10.hanacloud.ondemand.com

# HANA port — HANA Cloud always uses 443 (encrypted); on-premise default is 30015
HANA_PORT=443

# Database user that the test suite and forecasting engine connect as.
# Needs SELECT on the inventory/material master schemas listed below.
HANA_USER=INVENTORY_RO_USER

# Password for HANA_USER.  Store in your secrets manager; never hard-code.
HANA_PASSWORD=change_me_never_commit

# Default schema the connection resolves unqualified table names against.
# For the VEDANTA POC this is the ZSPR/ZSPN extract schema.
HANA_SCHEMA=INVENTORY_SCHEMA

# [optional] Encrypt the HANA connection (true/false). Default: true.
# Set to false only in a local dev environment with a self-signed cert.
HANA_ENCRYPT=true

# [optional] Validate the server's TLS certificate (true/false). Default: true.
HANA_SSL_VALIDATE_CERT=true


# -----------------------------------------------------------------------------
# GitHub — repository access
# Obtain from: GitHub → Settings → Developer settings →
#              Personal access tokens → Fine-grained tokens (recommended)
# Required scopes: Contents (read/write), Pull requests (read/write),
#                  Metadata (read-only)
# -----------------------------------------------------------------------------

# Personal Access Token used by CI and the cohort workspace to push branches
# and open pull requests against KritikasinghCL/cirruslabs-qa-e2e-test-cohort.
GITHUB_TOKEN=ghp_REPLACE_WITH_YOUR_PERSONAL_ACCESS_TOKEN

# GitHub repository owner (org or username). Do not change for this project.
GITHUB_OWNER=KritikasinghCL

# GitHub repository name. Do not change for this project.
GITHUB_REPO=cirruslabs-qa-e2e-test-cohort

# Base branch that all feature branches target. Do not change for this project.
GITHUB_BASE_BRANCH=main


# -----------------------------------------------------------------------------
# Google Cloud Storage — export target for HANA query results
# Obtain from: GCP Console → IAM → Service Accounts → create a key (JSON).
# The service account needs roles/storage.objectCreator on the target bucket.
# [optional] Only required when running hana_export_query_to_gcs workflows.
# -----------------------------------------------------------------------------

# GCP project that owns the export bucket.
GCP_PROJECT_ID=your-gcp-project-id

# Name of the Cloud Storage bucket where HANA exports land.
GCS_EXPORT_BUCKET=your-export-bucket-name

# Path to the service-account JSON key file on the local filesystem.
# Alternatively set GOOGLE_APPLICATION_CREDENTIALS (standard ADC env var).
GCP_SERVICE_ACCOUNT_KEY_FILE=/path/to/service-account-key.json


# -----------------------------------------------------------------------------
# Test-suite behaviour
# These control pytest execution; safe to leave at defaults for most runs.
# -----------------------------------------------------------------------------

# Log level for the test suite (DEBUG / INFO / WARNING / ERROR). Default: INFO.
LOG_LEVEL=INFO

# [optional] Set to "1" to run integration tests that hit the real HANA instance.
# Leave unset (or "0") to run only unit tests against in-memory fixtures.
RUN_INTEGRATION_TESTS=0

# [optional] Maximum rows returned by a single HANA query in tests. Default: 1000.
HANA_QUERY_MAX_ROWS=1000

# [optional] Comma-separated list of plant codes to scope integration tests to.
# Leave blank to run across all plants in the schema.
# Example: HZL_DEMO_01,HZL_DEMO_02
TEST_PLANT_FILTER=
