# =============================================================================
# .env.example — cirruslabs-qa-e2e-test-cohort
#
# Copy this file to .env and fill in the values for your local environment.
# NEVER commit .env to version control — it is listed in .gitignore.
#
# This project is a pure Python/pytest QA test suite with no running server
# and no database. As of today it reads no environment variables at runtime.
# The variables below document:
#   (a) optional pytest/test-runner knobs you may want to set locally, and
#   (b) placeholder slots for variables that future features will require
#       (e.g. when the suite grows to call external APIs or a CI service).
#
# How to obtain each value is noted inline.
# =============================================================================


# -----------------------------------------------------------------------------
# TEST RUNNER
# -----------------------------------------------------------------------------

# Absolute or relative path to the directory that contains the test files.
# Defaults to "tests/" when not set; override if you mirror the suite
# in a different location.
# Value: a filesystem path, e.g. tests/ or /home/user/project/tests
TEST_DIR=tests/

# Comma-separated pytest marks to run (e.g. "smoke,regression").
# Leave blank to run all tests.
# Value: any mark registered in pytest.ini / pyproject.toml
PYTEST_MARKS=

# Extra flags forwarded verbatim to pytest (e.g. "-x --tb=short").
# Value: any valid pytest CLI options
PYTEST_EXTRA_ARGS=


# -----------------------------------------------------------------------------
# RECIPE FILE UNDER TEST
# -----------------------------------------------------------------------------

# Path to the vegetable biryani recipe file, relative to the repo root.
# The test suite hard-codes this to "veg_biryani_recipe.txt"; set this
# variable only if you need to point the tests at a different file during
# local development.
# Value: a relative path from the repo root, e.g. veg_biryani_recipe.txt
RECIPE_FILE_PATH=veg_biryani_recipe.txt


# -----------------------------------------------------------------------------
# CI / GITHUB ACTIONS  (set automatically by the runner; listed here for
# local reproduction of a CI environment)
# -----------------------------------------------------------------------------

# GitHub personal access token used by any future test that calls the
# GitHub API (e.g. to verify PR status or fetch workflow results).
# Obtain: GitHub → Settings → Developer settings → Personal access tokens
# Scopes needed: repo (read), workflow (read)
# Value: ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_TOKEN=

# The GitHub repository in "owner/repo" format that the test suite targets.
# Value: KritikasinghCL/cirruslabs-qa-e2e-test-cohort
GITHUB_REPOSITORY=KritikasinghCL/cirruslabs-qa-e2e-test-cohort

# Branch the test suite runs against (used by any branch-aware tests).
# Value: main  (or a feature branch name during development)
GITHUB_REF_NAME=main


# -----------------------------------------------------------------------------
# FUTURE: EXTERNAL DATA / API INTEGRATION
# (Uncomment and fill in when these features are added)
# -----------------------------------------------------------------------------

# Base URL of the Cirruslabs Inventory & Forecasting API, if the test suite
# is extended to run integration tests against a live environment.
# Obtain: from the platform team / deployment runbook.
# Value: https://api.cirruslabs.io  or  http://localhost:8000
# API_BASE_URL=

# API key for authenticating against the Inventory API.
# Obtain: from the platform team's secret store (Vault / GitHub Secrets).
# Value: a UUID or bearer token string
# API_KEY=

# Connection string for the test database (if integration tests are added).
# Obtain: from the DBA or the Terraform outputs for the staging environment.
# Value: postgresql://user:password@host:5432/dbname
# DATABASE_URL=

# Staging environment flag — set to "true" to point tests at staging rather
# than production endpoints.
# Value: true | false
# USE_STAGING=false
