# ─────────────────────────────────────────────────────────────────────────────
# Vedanta Inventory Forecasting & Dashboard — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
#
# Quick-start:
#   1. cp .env.example .env
#   2. Fill in every blank value below
#   3. docker-compose up --build   (or restart the running container)
#   4. GET /api/v1/connectivity    — confirms which sources are live
#
# All blockers resolve automatically when the env vars are set.
# No code changes are required.  See BLOCKERS.md for the full guide.
# ─────────────────────────────────────────────────────────────────────────────

# ── App mode ──────────────────────────────────────────────────────────────────
ENV=production

# Set to "true" ONLY for local dev / unit tests (runs against fixtures/ CSVs).
# Must be "false" (or omitted) in production — live data only.
USE_TEST_FIXTURES=false

# ── GCS Data Sources ──────────────────────────────────────────────────────────
# BLOCKER-001: Not yet provided.  Set these to connect to GCS.
# All four required paths must be set; the three optional paths unlock
# Fill Rate (G-02), Critical Spares Availability (G-01), and Shutdown Calendar (G-04).

# Required — blocks all real-data metrics until set
GCS_BUCKET=<your-gcs-bucket-name>
GCS_CONSUMPTION_PATH=<path/within/bucket/consumption_history.csv>
GCS_STOCK_MASTER_PATH=<path/within/bucket/stock_master.csv>
GCS_PO_HISTORY_PATH=<path/within/bucket/po_history.csv>

# Optional — G-01: daily MB52 stock snapshot for Critical Spares Availability %
# Expected columns: material_code, plant, snapshot_date, stock_qty
GCS_DAILY_STOCK_SNAPSHOT_PATH=<path/within/bucket/daily_stock_snapshot.csv>

# Optional — G-02: RESB/reservation demand-met extract for Fill Rate %
# Expected columns: material_code, plant, requirement_date, demand_qty, met_qty
GCS_RESB_PATH=<path/within/bucket/resb_demand.csv>

# Optional — G-04: Shutdown/maintenance calendar for ContextFlow context
# Expected columns: shutdown_id, plant, shutdown_date, end_date, materials (pipe-separated), seasonal_flag, shutdown_type
GCS_SHUTDOWN_CALENDAR_PATH=<path/within/bucket/shutdown_calendar.csv>

# Path to GCP service account JSON key file (on host, mounted into container)
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp_sa_key.json
# Host path to mount into the container (docker-compose only)
GOOGLE_APPLICATION_CREDENTIALS_HOST_PATH=/path/on/host/to/service_account_key.json

# ── SAP RFC/BAPI Connector ────────────────────────────────────────────────────
# BLOCKER-002: Not yet provided.  SAP is the upstream source for all four data
# tables.  GCS is the primary ingestion path; SAP RFC is the secondary/fallback.
# pyrfc (SAP NW RFC SDK) must also be installed in the container — see BLOCKERS.md.
SAP_HOST=<sap-application-server-hostname-or-ip>
SAP_SYSNR=<system-number-e.g-00>
SAP_CLIENT=<client-e.g-100>
SAP_USER=<rfc-service-user>
SAP_PASSWORD=<rfc-service-user-password>

# ── ContextFlow MCP (Demand Forecasting) ─────────────────────────────────────
# BLOCKER-003: Not yet provided.  ContextFlow handles ONLY demand forecasting.
# Blocked until set: Safety Stock, ROP, Overstock (forecast-enhanced), Understock,
# Demand Forecast 3/6/12mo, Forecast Accuracy (MAPE), Forecast Bias.
CONTEXTFLOW_MCP_ENDPOINT=https://<your-contextflow-mcp-endpoint>
CONTEXTFLOW_API_KEY=<your-contextflow-api-key>
CONTEXTFLOW_TIMEOUT_SECONDS=60

# ── Metrics Thresholds (configurable — defaults match the data contract) ──────
# SMI: flag materials in the bottom N-th percentile of avg daily usage
SMI_USAGE_THRESHOLD_PERCENTILE=20.0
# NMI: lookback window in days (data contract §3.8 = 365 days)
NMI_LOOKBACK_MONTHS=6
# Overstock: flag if current_stock > avg_daily_cons_90d × threshold_days
OVERSTOCK_MARGIN_FACTOR=1.25
