# =============================================================================
# Vedanta Inventory Pipeline — Environment Variables
# S-2: SAP → GCS Extraction and Transformation Layer
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# GCS — required for the pipeline to run (G-07)
# ---------------------------------------------------------------------------
# Real GCS bucket name (without gs:// prefix)
GCS_BUCKET=

# Paths within the bucket to each SAP domain export
# These are the folder prefixes; the extractor reads all files under each prefix.
GCS_CONSUMPTION_PATH=consumption_history/
GCS_STOCK_MASTER_PATH=stock_master/
GCS_PO_HISTORY_PATH=po_history/
GCS_SHUTDOWN_CALENDAR_PATH=maintenance_calendar/

# Path to the GCP service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-service-account.json

# ---------------------------------------------------------------------------
# SAP RFC/BAPI — required only if pulling directly from SAP (not via GCS)
# ---------------------------------------------------------------------------
SAP_HOST=
SAP_SYSNR=
SAP_CLIENT=
SAP_USER=
SAP_PASSWORD=
SAP_LANGUAGE=EN

# ---------------------------------------------------------------------------
# SAP movement types for consumption (G-08)
# Confirm with Vedanta SAP team before changing.
# Standard list: 201 (GI to cost centre), 261 (GI to order),
#                262 (reversal of 261), 551 (scrapping), 601 (GI delivery)
# ---------------------------------------------------------------------------
SAP_CONSUMPTION_BWART_LIST=201,261,262,551,601

# ---------------------------------------------------------------------------
# ContextFlow MCP — required for demand forecast metrics (G-05)
# ---------------------------------------------------------------------------
CONTEXTFLOW_MCP_ENDPOINT=
CONTEXTFLOW_API_KEY=
CONTEXTFLOW_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Pipeline serving layer
# ---------------------------------------------------------------------------
# Local directory where raw and clean Parquet files are written
SERVING_DIR=/app/serving

# Null-threshold for gap detection (fraction, e.g. 0.10 = 10%)
NULL_THRESHOLD=0.10

# ---------------------------------------------------------------------------
# Metric parameters (configurable)
# ---------------------------------------------------------------------------
# Safety stock Z-score (1.65 = 95% service level, 2.33 = 99%)
SAFETY_STOCK_Z=1.65

# Overstock threshold: stock > AVG_DAILY_CONS × OVERSTOCK_DAYS
OVERSTOCK_DAYS=180

# Non-moving lookback window (days)
NMI_LOOKBACK_DAYS=365

# Slow-moving DOI threshold (days)
SMI_DOI_THRESHOLD_DAYS=90
